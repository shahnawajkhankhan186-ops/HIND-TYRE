# ====================================================
# HIND TYRES AND ACCESSORIES - Environment Variables
# ====================================================

# Backend / Server (.env in /server)
PORT=5001
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/hind_tyres?replicaSet=rs0
JWT_SECRET=super_secret_hind_tyres_jwt_key_998877665544332211
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Brevo (Sendinblue) Transactional Email API (Recommended - 300 free emails/day)
# 1. Sign up at https://brevo.com
# 2. Get API key: SMTP & API -> API Keys -> Generate (starts with xkeysib-)
# 3. Add sender email: Senders & IP -> Add sender (verify via inbox link)
BREVO_API_KEY=xkeysib-your-brevo-api-key-here
BREVO_SENDER_EMAIL=your-verified-brevo-email@gmail.com
BREVO_SENDER_NAME="HIND TYRES & ACCESSORIES"

# Nodemailer / Gmail SMTP Configuration (Alternative fallback)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=billing@hindtyres.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM="HIND TYRES & ACCESSORIES" <billing@hindtyres.com>
ADMIN_RECEIPT_EMAIL=admin@hindtyres.com

# Frontend / Client (.env in /client)
# VITE_API_BASE_URL=http://localhost:5001/api

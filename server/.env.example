# Server Configuration
PORT=5001
NODE_ENV=development

# --- Database Options ---
# Option 1: Local / Cloud MongoDB (e.g. MongoDB Atlas free cluster)
MONGODB_URI=mongodb://127.0.0.1:27017/hind_tyres?replicaSet=rs0
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/hind_tyres?retryWrites=true&w=majority

# Option 2: Supabase (PostgreSQL)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres

# Authentication
JWT_SECRET=super_secret_hind_tyres_jwt_key_998877665544332211
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Email / SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="HIND TYRES & ACCESSORIES" <billing@hindtyres.com>
ADMIN_RECEIPT_EMAIL=admin@hindtyres.com

# Server Configuration
PORT=5001
NODE_ENV=development

# --- Database Options & Environment Separation ---
# 1. Localhost Development: uses hind_tyres_dev (isolated dummy data for testing)
# MONGODB_URI=mongodb://127.0.0.1:27017/hind_tyres_dev?replicaSet=rs0
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/hind_tyres_dev?retryWrites=true&w=majority
#
# 2. Production (Render): uses hind_tyres_prod (real client business data)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/hind_tyres_prod?retryWrites=true&w=majority
#
# 3. Automated Tests: code automatically routes tests to hind_tyres_test

MONGODB_URI=mongodb://127.0.0.1:27017/hind_tyres_dev?replicaSet=rs0

# Option 2: Supabase (PostgreSQL)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres

# Authentication
JWT_SECRET=super_secret_hind_tyres_jwt_key_998877665544332211
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Email / Brevo Transactional Service (Recommended: BREVO_API_KEY)
# Create a free account on brevo.com -> SMTP & API -> API Keys -> Generate key
BREVO_API_KEY=
BREVO_SENDER_NAME="HIND TYRES & ACCESSORIES"
BREVO_SENDER_EMAIL=hindtyre01@gmail.com

# Brevo SMTP Relay Fallback (smtp-relay.brevo.com / port 587)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="HIND TYRES & ACCESSORIES" <hindtyre01@gmail.com>
ADMIN_RECEIPT_EMAIL=admin@hindtyres.com
